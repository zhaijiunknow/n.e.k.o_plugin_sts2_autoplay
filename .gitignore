__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
vendor/
# `vendor/` 是插件的 Python 依赖目录。Windows 上 git 不分大小写，它会连带吞掉模组里
# AlphaDefect 编码器的源码目录 Policy/Vendor/ —— 那是要入库的（没有它模组编译不过）。
!game_mod/nekospire/Policy/Vendor/
# 同理：策略网络推理旁路随包带的上游 Python 代码（MIT），也是要入库、要进插件包的。
!policy_sidecar/vendor/
dist/
build/
*.egg-info/
store.db
.env
.DS_Store
.codegraph/

# agent/team local state and analysis artifacts (166MB+)
.dsh-artifacts/*
# 例外：度量脚手架是 t10 交付物，也是 t11/t13 前后对照的唯一判据来源，
# 必须进版本库 —— 否则 `test_reflection_metrics_contract` 在 CI 上永远无解。
!.dsh-artifacts/reflection_metrics.py
.agent-teams/
plugin.toml.lock

# runtime data written by history_view.py (never tracked)
static/autoplay_history.json

# AlphaDefect policy data (vocabulary / relic list): derived from game data, not covered by upstream's MIT
# license. Regenerated by game_mod/scripts/vendor-alphadefect.py --apply.
game_mod/nekospire/Policy/Data/
# 下载前端读的进度快照（运行时生成）
static/policy_status.json
