<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SimTests</RootNamespace>
    <AssemblyName>SimTests</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <!-- Link the pure Sim sources (they are game-type-free). Game-coupled files (SimBuild/SimCapture)
       are excluded so this runs without sts2.dll. -->
  <ItemGroup>
    <Reference Include="System.IO.Hashing">
      <HintPath>D:/Steam/steamapps/common/Slay the Spire 2/data_sts2_windows_x86_64/System.IO.Hashing.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\neko_comm\Game\Sim\SimGameRandom.cs" />
    <Compile Include="..\neko_comm\Game\Sim\SimPayload.cs" />
    <Compile Include="..\neko_comm\Game\Sim\SimState.cs" />
    <Compile Include="..\neko_comm\Game\Sim\SimCommand.cs" />
    <Compile Include="..\neko_comm\Game\Sim\SimResolver.cs" />
    <Compile Include="..\neko_comm\Game\Sim\SimDiff.cs" />
    <Compile Include="..\neko_comm\Game\Sim\SimReplay.cs" />
    <Compile Include="..\neko_comm\Game\Sim\SimRng.cs" />
    <Compile Include="..\neko_comm\Game\Sim\SimPower.cs" />
    <Compile Include="..\neko_comm\Game\Sim\SimIntents.cs" />
    <Compile Include="..\neko_comm\Game\Sim\SimBudget.cs" />
    <Compile Include="..\neko_comm\Game\Sim\SimSearch.cs" />
    <Compile Include="..\neko_comm\Game\Sim\SimOrb.cs" />
    <Compile Include="..\neko_comm\Game\Sim\SimRelic.cs" />
    <Compile Include="..\neko_comm\Game\Sim\SimOnPlay.cs" />
  </ItemGroup>
</Project>
